{
  "name": "[dev] partner_feed_ingest",
  "max_concurrent_runs": 1,
  "schedule": {
    "quartz_cron_expression": "0 0 5 * * ?",
    "timezone_id": "UTC",
    "pause_status": "PAUSED"
  },
  "tags": {
    "demo": "pipeline-agent",
    "env": "dev"
  },
  "parameters": [
    {
      "name": "catalog",
      "default": "dev"
    },
    {
      "name": "env",
      "default": "dev"
    },
    {
      "name": "layout",
      "default": "catalog"
    },
    {
      "name": "flaky_rate",
      "default": "0"
    },
    {
      "name": "leak_fake_token",
      "default": "false"
    }
  ],
  "tasks": [
    {
      "task_key": "partner_feed",
      "notebook_task": {
        "notebook_path": "/Workspace/Shared/orders-pipelines-dev/notebooks/partner_feed",
        "source": "WORKSPACE"
      }
    }
  ]
}
