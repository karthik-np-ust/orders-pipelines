{
  "name": "[dev] orders_pipeline",
  "max_concurrent_runs": 1,
  "schedule": {
    "quartz_cron_expression": "0 0 6 * * ?",
    "timezone_id": "UTC",
    "pause_status": "PAUSED"
  },
  "tags": {
    "demo": "pipeline-agent",
    "env": "dev"
  },
  "parameters": [
    {
      "name": "catalog",
      "default": "dev"
    },
    {
      "name": "env",
      "default": "dev"
    },
    {
      "name": "layout",
      "default": "catalog"
    }
  ],
  "tasks": [
    {
      "task_key": "ingest_bronze",
      "notebook_task": {
        "notebook_path": "/Workspace/Shared/orders-pipelines-dev/notebooks/ingest_bronze",
        "source": "WORKSPACE"
      }
    },
    {
      "task_key": "transform_silver",
      "notebook_task": {
        "notebook_path": "/Workspace/Shared/orders-pipelines-dev/notebooks/transform_silver",
        "source": "WORKSPACE"
      },
      "depends_on": [
        {
          "task_key": "ingest_bronze"
        }
      ]
    },
    {
      "task_key": "build_gold",
      "notebook_task": {
        "notebook_path": "/Workspace/Shared/orders-pipelines-dev/notebooks/build_gold",
        "source": "WORKSPACE"
      },
      "depends_on": [
        {
          "task_key": "transform_silver"
        }
      ]
    }
  ]
}
